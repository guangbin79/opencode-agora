#!/usr/bin/env python3
"""agora CLI（F14→F64）：bash 可判定的条件谓词——看门狗规范条件等待＋派发等待一体（dispatch 为唯一写面）。

dispatch 子命令派发任务并阻塞等终态（派发＋等待一体）；watch 子命令盯
非本回合派发的在飞任务（同事任务/跨会话遗留/中断重挂）阻塞至终态，对齐
docker wait / kubectl wait 约定。status 子命令（F28 防误杀）单查任务三态
判读：数据全取既有 /board 单任务视图＋/doctor（零服务端新端点），分类
客户端推导。取数照抄 board_tui.py 形态：
$AGORA_HOME/.agora/{root.token,service.json}，零直读状态文件、零格式逆向。
非 MCP agora sleep（那是 agent 回合内本地睡眠，两者不互替）。
"""
import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

TERMINAL = frozenset(("merged", "closed", "blocked", "cancelled"))
_INFLIGHT = ("todo", "dispatched", "running", "done", "verify_failed", "reopened")
_INTERVAL = 15        # 内部轮询间隔（秒）
_HTTP_TIMEOUT = 5     # 单次请求超时（board_tui 同值）
_DISPATCH_TIMEOUT = 30  # 派发一跳重活：env 物化＋worker 会话拉起（服务端串行）——对齐 MCP http_call 30s
_DEFAULT_TIMEOUT = 3600  # F61 wait 超时缺省（原 1800；AGORA_WAIT_TIMEOUT env 可覆写）
_TIMEOUT_MSG = "须为非负有限秒数"
_STALE_AFTER = 1200   # 心跳冷阈值（秒）——与 agorad report._STALE_AFTER 同口径（客户端推导锚）


class Fail(Exception):
    """终局异常（不可重试）——exit 2。"""


class Transient(Exception):
    """瞬时不可达（连接拒等 OSError 族）——阻塞形态内部重试吸收。"""


class Rejected(Transient):
    """认牌失败（401/403）——牌换代窗口瞬态；不跟随换模时仍终局 Fail。"""


def _pointer_home():
    """~/.agora-home 指针回退（gt-32c051 统一发现桥；board_tui 同形）。"""
    try:
        return ((Path.home() / ".agora-home").read_text(encoding="utf-8")
                .split("\n", 1)[0].strip() or None)
    except (OSError, ValueError):  # ValueError＝坏字节（UnicodeDecodeError 非 OSError 族）
        return None


def discover(home=None):
    """root 牌＋端口：$AGORA_HOME/.agora/{root.token,service.json}（board_tui 同形）。"""
    home = Path(home or os.environ.get("AGORA_HOME") or _pointer_home()
                or Path.home() / "plaza")
    sj = json.loads((home / ".agora" / "service.json").read_text(encoding="utf-8"))
    port = int(sj["port"])  # 非数端口（半写形态）在此炸 ValueError/TypeError，不外溢 fetch
    token = (home / ".agora" / "root.token").read_text(encoding="utf-8").strip()
    if "\n" in token or "\r" in token:  # 控制符会让 putheader 带牌面炸进 stderr／折叠改头
        raise ValueError("root 牌撕裂（含换行/回车）")
    return f"http://127.0.0.1:{port}", token


def _err_note(e):
    """HTTPError 服务拒因透传（F64 dispatch 首个写面消费者：F23 硬闸/quota
    拒因须直达调用方，不令其翻审计）；空体/坏体/非 dict→空串退回裸状态码。"""
    try:
        why = json.loads(e.read().decode()).get("error")
    except Exception:  # 纯装饰取因绝不改控制流：坏体/断体(IncompleteRead)/非 dict 一律空串
        return ""
    return f" {why}" if why else ""


def _call(base, token, path, body, timeout=_HTTP_TIMEOUT):
    """HTTP 取数缝（fetch/dispatch/status 共用）：POST <path> 带根牌回解析 JSON。

    401/403→Rejected（认牌失败）、其余 HTTP 错→Fail（404＋/board 注任务未知，
    服务端 error 拒因尾透）、网络错（OSError 族）→Transient（可重试）。
    """
    req = urllib.request.Request(
        base + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "X-Agora-Token": token},
        method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):  # 认牌失败：牌换代/撕裂对窗口，跟随形态按瞬态
            raise Rejected(f"HTTP {e.code}: {path}{_err_note(e)}") from None
        note = "（任务未知）" if e.code == 404 and path == "/board" else ""
        raise Fail(f"HTTP {e.code}" + note + f": {path}{_err_note(e)}") from None
    except OSError as e:  # URLError（连接拒等）＝瞬时，可重试
        raise Transient(str(e)) from None


def fetch(base, token, tid):
    """POST /board 单任务视图 → (state, commit)。报因尾附 tid（看门狗聚合 stderr 可归任务）。"""
    try:
        t = _call(base, token, "/board", {"task": tid})["task"]
    except (Fail, Rejected) as e:
        raise type(e)(f"{e}: {tid}") from None
    return t["state"], t.get("commit")


def classify(state):
    """状态分类缝（exit code 决策）：终态→0，在飞（含未知态）→1。"""
    return 0 if state in TERMINAL else 1


def wait(tid, base, token, timeout=_DEFAULT_TIMEOUT, once=False,
         interval=_INTERVAL, clock=time.monotonic, pause=time.sleep,
         reread=None):
    """轮询至终态：返回 (exit, stdout 行)；重试至超时仍不可达 raise Fail。

    reread（run_wait 注入 discover）每轮轮询前重读指针——服务换模
    （杀旧拉新、端口/牌换代）即跟随新端点续等，不对死端口空转到超时；
    跟随时认牌失败（401/403，撕裂对/换代窗口）按瞬态重试。
    """
    deadline = clock() + timeout
    while True:
        if reread:
            try:
                nb, nt = reread()
                if nb and nt:  # 半写空端点/空牌不采纳，保持旧端点下轮再读
                    base, token = nb, nt
            except (OSError, ValueError, TypeError, KeyError):
                pass  # 指针半写/缺失（含非 dict JSON）保持旧端点，下轮再读
        try:
            state, commit = fetch(base, token, tid)
        except Transient as e:
            if isinstance(e, Rejected) and reread is None:
                raise Fail(str(e)) from None  # 不跟随换模：认牌失败维持终局
            if once or clock() >= deadline:
                head = ("认牌失败" if isinstance(e, Rejected)
                        else "服务不可达" if once else "服务不可达（重试至超时）")
                raise Fail(f"{head}: {e}") from None
        else:
            if classify(state) == 0:
                return 0, (f"{state} @{commit[:12]}" if commit else state)
            if once or clock() >= deadline:
                return 1, f"in-flight: {state}"
        pause(min(interval, max(0.0, deadline - clock())))


def run_wait(a):
    timeout = _resolve_timeout(a.timeout)  # F61：旗 > env > 缺省，先于取数（非法 env 不发请求）
    base, token = discover()
    if not token:
        raise Fail("root 牌缺失")
    code, line = wait(a.task_id, base, token, timeout=timeout, once=a.once,
                      reread=discover)
    print(line)
    return code


def run_dispatch(a):
    """F64 派发＋等待一体：薄代理 agorad 既有 /task_dispatch 端点（服务端
    逻辑零改动），成功后进程内 wait() 阻塞至终态；退出码沿袭 watch 语义。
    """
    timeout = _resolve_timeout(a.timeout)  # AGORA_WAIT_TIMEOUT 平移生效
    base, token = discover()
    if not token:
        raise Fail("root 牌缺失")
    try:
        _call(base, token, "/task_dispatch", {"task": a.task_id},
              timeout=_DISPATCH_TIMEOUT)  # 派发重活＞轮询预算：5s 级超时＝假失败真在飞
    except Transient as e:
        if isinstance(e, Rejected):  # 派发被拒（F23 硬闸/quota）＝终局，拒因 exit 2
            raise
        # 派发跳瞬时（30s 超时/连接抖动）≠未受理：服务端串行重活可能已落地
        # （worker 已拉起）——不终局 exit 2，落 wait() 对账：已派发即续等终态；
        # 仍 todo 则轮询至到期（exit 1，todo 态自证派发未落，重派安全）。
        # shortcut: 非 401/403 HTTP 错（Fail）仍终局 exit 2——4xx 拒因须直达；
        # 5xx 窄窗（flip 后 append_event/_pages 抛）＝有意取舍不对账，后果有界
        # （重派被服务端 todo/blocked 闸守），when: 出现误报实例再议 5xx 对账
    code, line = wait(a.task_id, base, token, timeout=timeout, reread=discover)
    print(line)
    return code


def status_view(tid, task, stale_ids, now):
    """F28 三态判读（客户端推导，零服务端新端点）：数据＝/board 单任务视图＋/doctor。

    fresh＝心跳近（last_seen 距今≤_STALE_AFTER）；busy_round＝在飞＋心跳冷＋
    不在 doctor stale_candidates（基线含 env 活性，env 在写＝深潜中）；stale_candidate
    ＝在 doctor 僵态候选单。终态或无 worker＝无判读（class None）。
    """
    state = task["state"]
    seen = task.get("last_seen")
    ago = None if not seen else max(0, int(now - seen))
    if state in TERMINAL or not task.get("worker_sid"):
        cls = None
    elif tid in stale_ids:
        cls = "stale_candidate"
    elif ago is None or ago > _STALE_AFTER:
        cls = "busy_round"
    else:
        cls = "fresh"
    return {"task": tid, "state": state, "last_seen_ago": ago, "class": cls}


def run_status(a):
    base, token = discover()
    if not token:
        raise Fail("root 牌缺失")
    now = time.time()
    try:
        task = _call(base, token, "/board", {"task": a.task_id})["task"]
        doc = _call(base, token, "/doctor", {})
    except Fail as e:  # 报因尾附 tid（镜像 fetch：看门狗聚合 stderr 可归任务）
        raise type(e)(f"{e}: {a.task_id}") from None
    except Transient as e:  # 单查不重试：判读要新鲜，旧数据不如报错
        head = "认牌失败" if isinstance(e, Rejected) else "服务不可达"
        raise Fail(f"{head}: {e}: {a.task_id}") from None
    v = status_view(a.task_id, task,
                    {tid for tid, _ in doc.get("stale_candidates", [])},
                    now)  # 旧 daemon 无该键→空集降级，不裸 KeyError
    if a.json:
        print(json.dumps(v, ensure_ascii=False))
    else:
        ago = "-" if v["last_seen_ago"] is None else f"{v['last_seen_ago']}s"
        print(f"{v['task']} state={v['state']} last_seen={ago} "
              f"class={v['class'] or '-'}")
    return 0


def _timeout_arg(v):
    """非负有限秒数；拒 nan/inf/负值（nan 会让 deadline 比较恒 False 变热轮询）。"""
    try:
        t = float(v)
    except (ValueError, TypeError):
        raise argparse.ArgumentTypeError(_TIMEOUT_MSG) from None
    if not 0 <= t < float("inf"):
        raise argparse.ArgumentTypeError(_TIMEOUT_MSG)
    return t


def _resolve_timeout(flag):
    """F61 超时解析：旗 > AGORA_WAIT_TIMEOUT env > 缺省 3600。

    env 值过 _timeout_arg 同一道校验（旗在案不走 env）；非法 env → Fail（exit 2），
    报错形态仿 AGORA_VERIFY_TIMEOUT。
    """
    if flag is not None:
        return flag
    raw = os.environ.get("AGORA_WAIT_TIMEOUT")
    if raw is None:
        return _DEFAULT_TIMEOUT
    try:
        return _timeout_arg(raw)
    except argparse.ArgumentTypeError:
        raise Fail(f"AGORA_WAIT_TIMEOUT 须为正数秒（收到 {raw!r}）") from None


def _parser():
    ap = argparse.ArgumentParser(
        prog="agora",
        description="agora CLI——bash 可判定的条件谓词（F14→F64）：dispatch＝"
                    "派发＋等待一体（唯一写面），watch/status 只读。")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")
    d = sub.add_parser("dispatch",
                       help="派发任务并阻塞等终态（派发＋等待一体，F64）",
                       description="派发任务并阻塞等终态（F64 一体化）：薄代理 agorad 既有"
                                   " dispatch 端点，成功后进程内阻塞至终态——派发与等待一条"
                                   "命令，退出通知即唤醒派发会话。",
                       epilog="退出码：0＝终态到达（merged/closed/blocked/cancelled 任一）\n"
                              f"1＝--timeout 到期仍在飞（{'/'.join(_INFLIGHT)}）\n"
                              "2＝异常（用法错/AGORA_WAIT_TIMEOUT 非法/派发被拒/任务未知 404"
                              "/root 牌缺失/认牌失败/重试至超时仍不可达）",
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    d.add_argument("task_id", metavar="task-id", help="任务 id（ag-xxxxxx 或历史 task-/gt-xxxxxx）")
    d.add_argument("--timeout", type=_timeout_arg, default=None,
                   help="到期仍在飞退出 1（秒）；缺省 3600，可经 AGORA_WAIT_TIMEOUT"
                        " 环境变量覆写（防调用方永挂）")
    d.set_defaults(fn=run_dispatch)
    w = sub.add_parser("watch",
                       help="盯非本回合派发的在飞任务至终态（--once 单查）",
                       description="盯非本回合派发的在飞任务（同事任务/跨会话遗留/会话中断"
                                   "重挂）至终态（--once 单查）；本回合派发用 dispatch（派发"
                                   "＋等待一体）；非 MCP agora sleep（那是 agent 回合内本地"
                                   "睡眠）。",
                       epilog="退出码：0＝终态到达（merged/closed/blocked/cancelled 任一）\n"
                              f"1＝--timeout 到期仍在飞（{'/'.join(_INFLIGHT)}），"
                              "或 --once 下当前在飞\n"
                              "2＝异常（用法错/AGORA_WAIT_TIMEOUT 非法/任务未知 404/root 牌缺失"
                              "/认牌失败/重试至超时仍不可达）",
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    w.add_argument("task_id", metavar="task-id", help="任务 id（ag-xxxxxx 或历史 task-/gt-xxxxxx）")
    w.add_argument("--timeout", type=_timeout_arg, default=None,
                   help="到期仍在飞退出 1（秒）；缺省 3600，可经 AGORA_WAIT_TIMEOUT"
                        " 环境变量覆写（防调用方永挂）")
    w.add_argument("--once", action="store_true", help="单查形态，立即返回不阻塞")
    w.set_defaults(fn=run_wait)
    s = sub.add_parser(
        "status", help="任务三态判读单查（F28 防误杀：cancel 前先看一眼）",
        description="单查任务三态判读：state＋last_seen 距今秒＋分类——"
                    "fresh(心跳近)/busy_round(在飞＋心跳冷＋非僵态候选)/"
                    "stale_candidate(在 doctor 僵态候选单)；数据取 /board＋/doctor。",
        epilog="退出码：0＝取数成功（判读读输出，不作退出码）\n"
               "2＝异常（用法错/任务未知/不可达/认牌失败）",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    s.add_argument("task_id", metavar="task-id", help="任务 id（ag-xxxxxx 或历史 task-/gt-xxxxxx）")
    s.add_argument("--json", action="store_true", help="机器可读 JSON 形态")
    s.set_defaults(fn=run_status)
    return ap


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        a = _parser().parse_args(argv)
        return a.fn(a)
    except KeyboardInterrupt:
        return 130  # 打断≠终态：非零防看门狗误判 merged
    except Exception as e:
        print(f"agora: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
